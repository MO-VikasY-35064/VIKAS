# Copy this file to ".env" (same folder as run.py) and fill in your values.
# run.py automatically loads ".env" before starting the app - this is the
# easiest way to point the app at SQL Server when running locally with
# `python run.py` (as opposed to deploying under IIS, where these instead
# go in web.config - see docs/AZURE_IIS_DEPLOYMENT.md).
#
# IMPORTANT: after editing this file, fully stop and restart `python run.py`
# for the changes to take effect - Flask does not reload environment
# variables on its own.

# ---- Switch the database engine ----
DB_ENGINE=sqlite

# ---- SQL Server connection ----
# For a local SQL Server instance managed via SSMS, MSSQL_SERVER is often
# "localhost" or "localhost\SQLEXPRESS" (Express edition) or
# ".\SQLEXPRESS". Check the "Server name" shown when you connect in SSMS.
MSSQL_SERVER=Vikas\THEVKY
MSSQL_DATABASE=TailoringDB

# Leave USERNAME/PASSWORD blank to use Windows Authentication (the
# default for a local instance you connect to via SSMS with your Windows
# login). Fill them in only if you specifically created a SQL Server
# login (SQL Authentication).
MSSQL_USERNAME=
MSSQL_PASSWORD=

# Must match a driver name actually installed on this machine - check
# with the PowerShell snippet in docs/AZURE_IIS_DEPLOYMENT.md /
# README.md if you're not sure which one you have.
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# ---- General ----
SECRET_KEY=dev-secret-change-me

EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=techhelpvikas@gmail.com
SMTP_PASSWORD=xdhrnzbhflytpswv
EMAIL_FROM=techhelpvikas@gmail.com
