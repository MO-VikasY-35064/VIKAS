<?xml version="1.0" encoding="utf-8"?>

<configuration>

  <system.webServer>

    <!-- =====================================================
         Flask / Waitress
         ===================================================== -->

    <handlers>
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform
        processPath="D:\Learning\TailoringWebApp\venv\Scripts\python.exe"
        arguments="-m waitress --listen=127.0.0.1:%HTTP_PLATFORM_PORT% run:app"
        workingDirectory="D:\Learning\TailoringWebApp"
        stdoutLogEnabled="true"
        stdoutLogFile="D:\Learning\TailoringWebApp\logs\stdout.log"
        startupTimeLimit="60"
        startupRetryCount="3">

      <environmentVariables>

        <!-- Flask -->
        <environmentVariable
            name="FLASK_ENV"
            value="production" />

        <environmentVariable
            name="FLASK_DEBUG"
            value="0" />

        <!--
          Generate with:

          python -c "import secrets; print(secrets.token_urlsafe(64))"

          Replace the value below.
        -->
        <environmentVariable
            name="SECRET_KEY"
            value="REPLACE_WITH_YOUR_RANDOM_SECRET" />

        <!-- Database -->
        <environmentVariable
            name="DB_ENGINE"
            value="mssql" />

        <environmentVariable
            name="MSSQL_SERVER"
            value="Vikas\THEVKY" />

        <environmentVariable
            name="MSSQL_DATABASE"
            value="TailoringDB" />

        <!-- Windows Authentication -->
        <environmentVariable
            name="MSSQL_USERNAME"
            value="" />

        <environmentVariable
            name="MSSQL_PASSWORD"
            value="" />

        <environmentVariable
            name="MSSQL_DRIVER"
            value="ODBC Driver 18 for SQL Server" />

        <!-- Email -->
        <environmentVariable
            name="EMAIL_BACKEND"
            value="smtp" />

        <environmentVariable
            name="SMTP_HOST"
            value="smtp.gmail.com" />

        <environmentVariable
            name="SMTP_PORT"
            value="587" />

        <environmentVariable
            name="SMTP_USERNAME"
            value="" />

        <environmentVariable
            name="SMTP_PASSWORD"
            value="" />

        <environmentVariable
            name="EMAIL_FROM"
            value="noreply@yourdomain.com" />

      </environmentVariables>

    </httpPlatform>


    <!-- =====================================================
         Security Headers
         ===================================================== -->

    <httpProtocol>
      <customHeaders>

        <remove name="X-Powered-By" />

        <add name="X-Content-Type-Options"
             value="nosniff" />

        <add name="X-Frame-Options"
             value="SAMEORIGIN" />

        <add name="Referrer-Policy"
             value="strict-origin-when-cross-origin" />

        <add name="Permissions-Policy"
             value="camera=(), microphone=(), geolocation=()" />

      </customHeaders>
    </httpProtocol>


    <!-- =====================================================
         Request Filtering
         ===================================================== -->

    <security>

      <requestFiltering
          allowDoubleEscaping="false">

        <requestLimits
            maxAllowedContentLength="31457280" />

        <fileExtensions>

          <add fileExtension=".env"
               allowed="false" />

          <add fileExtension=".ini"
               allowed="false" />

          <add fileExtension=".log"
               allowed="false" />

          <add fileExtension=".sqlite"
               allowed="false" />

          <add fileExtension=".db"
               allowed="false" />

          <add fileExtension=".bak"
               allowed="false" />

          <add fileExtension=".backup"
               allowed="false" />

          <add fileExtension=".sql"
               allowed="false" />

        </fileExtensions>

        <hiddenSegments>

          <add segment=".git" />
          <add segment=".github" />
          <add segment=".venv" />
          <add segment="venv" />
          <add segment="__pycache__" />
          <add segment="logs" />
          <add segment="instance" />

        </hiddenSegments>

      </requestFiltering>

    </security>


    <!-- =====================================================
         Directory Browsing
         ===================================================== -->

    <directoryBrowse enabled="false" />


    <!-- =====================================================
         Compression
         ===================================================== -->

    <urlCompression
        doStaticCompression="true"
        doDynamicCompression="true" />


    <!-- =====================================================
         Error Handling
         ===================================================== -->

    <httpErrors
        errorMode="Custom"
        existingResponse="PassThrough" />

  </system.webServer>

</configuration>
